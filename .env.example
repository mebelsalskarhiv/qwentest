# Virtuoso MES Production Environment Variables
# Copy this file to .env and update values for your deployment

# ===========================================
# DOMAIN CONFIGURATION
# ===========================================
VIRTUOSO_DOMAIN=virtuoso-mes.local
LETSENCRYPT_EMAIL=admin@yourdomain.com

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=virtuoso
POSTGRES_PASSWORD=changeme_production_password_use_strong_password
POSTGRES_DB=virtuoso_mes

# ===========================================
# SECURITY - CHANGE IN PRODUCTION!
# ===========================================
SECRET_KEY=change_this_super_secret_key_in_production_use_openssl_rand_base64_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# BILLING (Optional - Stripe integration)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_STARTUP=price_xxx
STRIPE_PRICE_ID_PROFESSIONAL=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx

# ===========================================
# DEMO TENANT CONFIGURATION
# ===========================================
DEMO_TENANT_SUBDOMAIN=demo
DEMO_TENANT_NAME=Virtuoso MES Demo
DEMO_ADMIN_EMAIL=demo@virtuoso-mes.local
DEMO_ADMIN_PASSWORD=demo123
